{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@markless/server/src/*": [
        "../../packages/server/src/*"
      ],
      "@markless/shared/src/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-api/types/**/*.ts",
    ".next-api/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
