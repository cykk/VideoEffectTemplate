{
  "name": "@markless/web",
  "private": true,
  "version": "0.1.0",
  "dependencies": {
    "@markless/shared": "workspace:*",
    "vinext": "1.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.1.1"
  },
  "type": "module",
  "scripts": {
    "predev:vinext": "node ../../scripts/generate-blog-data.mjs",
    "dev:vinext": "vite dev --port 3001",
    "prebuild:vinext": "node ../../scripts/generate-blog-data.mjs",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.38",
    "@cloudflare/vite-plugin": "^1.0.0",
    "wrangler": "4.151.3"
  }
}
