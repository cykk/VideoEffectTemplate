{
  "name": "mp3totext",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm run blog:generate && node scripts/dev-workspace.mjs",
    "build": "pnpm run build:web && pnpm run build:api",
    "start": "echo Use pnpm run start:web or pnpm run start:api",
    "i18n:translation:status": "node -e \"console.log('Translation pipeline is disabled in English-only mode.')\"",
    "i18n:check:utf8": "node scripts/check-i18n-utf8.cjs",
    "i18n:check:fallbacks": "node scripts/check-i18n-fallbacks.cjs",
    "i18n:check:fallbacks:report": "node scripts/check-i18n-fallbacks.cjs --report-only",
    "i18n:check:fallbacks:update": "node scripts/check-i18n-fallbacks.cjs --update-baseline",
    "i18n:check:hardcoded": "node scripts/check-i18n-hardcoded.cjs",
    "i18n:check:hardcoded:report": "node scripts/check-i18n-hardcoded.cjs --report-only",
    "i18n:check:hardcoded:update": "node scripts/check-i18n-hardcoded.cjs --update-baseline",
    "i18n:check:new": "npm run i18n:check:utf8 && npm run i18n:check:fallbacks && npm run i18n:check:hardcoded",
    "i18n:qa": "npm run i18n:check:utf8 && npm run lint:i18n && npm run i18n:check:fallbacks:report && npm run i18n:check:hardcoded:report",
    "lint": "npm run lint:hardcode:dev",
    "lint:i18n": "eslint \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\"",
    "lint:i18n:file": "eslint",
    "db:generate": "dotenv -e .env.api.local -- drizzle-kit generate",
    "db:generate:local": "dotenv -e .env.api.local -- drizzle-kit generate",
    "db:generate:prod": "dotenv -e .env.api.production -- drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "dotenv -e .env.api.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.api.production -- drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:local": "dotenv -e .env.api.local -- drizzle-kit push",
    "db:push:prod": "dotenv -e .env.api.production -- drizzle-kit push",
    "appsumo:import-codes": "dotenv -e .env.api.local -- node scripts/import-appsumo-codes.mjs",
    "appsumo:import-codes:dry-run": "dotenv -e .env.api.local -- node scripts/import-appsumo-codes.mjs --dry-run",
    "appsumo:import-codes:prod": "dotenv -e .env.api.production -- node scripts/import-appsumo-codes.mjs",
    "appsumo:import-codes:prod:dry-run": "dotenv -e .env.api.production -- node scripts/import-appsumo-codes.mjs --dry-run",
    "email:dev": "email dev",
    "email:export": "email export",
    "lint:hardcode:js": "node node_modules/eslint/bin/eslint.js --rule \"i18next/no-literal-string:error\" --rule \"no-restricted-syntax:error\" \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\"",
    "lint:hardcode:css": "node node_modules/stylelint/bin/stylelint.mjs --max-warnings=0 \"apps/web/src/**/*.css\"",
    "lint:hardcode:js:dev": "node node_modules/eslint/bin/eslint.js \"apps/web/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.{ts,tsx}\"",
    "lint:hardcode:css:dev": "node node_modules/stylelint/bin/stylelint.mjs \"apps/web/src/**/*.css\"",
    "lint:hardcode:dev": "npm run lint:hardcode:js:dev && npm run lint:hardcode:css:dev",
    "lint:hardcode": "npm run lint:hardcode:js && npm run lint:hardcode:css",
    "blog:generate": "node scripts/generate-blog-data.mjs",
    "dev:web": "pnpm run blog:generate && dotenv -e .env.web.local -- next dev ./apps/web --webpack --hostname 0.0.0.0 --port 3000",
    "dev:api": "dotenv -e .env.api.local -- next dev ./apps/api --webpack --hostname 0.0.0.0 --port 3001",
    "dev:trigger": "dotenv -e .env.api.local -- npx trigger.dev@4.6.2 dev",
    "trigger:deploy:prod:dry": "pnpm dlx trigger.dev@4.6.2 deploy --env prod --dry-run --skip-update-check --env-file .env.trigger.production",
    "trigger:deploy:prod": "pnpm dlx trigger.dev@4.6.2 deploy --env prod --skip-update-check --env-file .env.trigger.production",
    "build:web": "pnpm run blog:generate && next build ./apps/web --webpack",
    "build:web:local": "pnpm run blog:generate && dotenv -e .env.web.local -- next build ./apps/web --webpack",
    "build:web:prod": "pnpm run blog:generate && dotenv -e .env.web.production -- next build ./apps/web --webpack",
    "cf:check": "pnpm --filter @markless/web exec vinext check",
    "cf:dev": "pnpm run cf:env:check && dotenv -e .env.web.cloudflare -- pnpm --filter @markless/web run dev:vinext",
    "cf:env:check": "dotenv -e .env.web.cloudflare -- node scripts/check-cloudflare-env.mjs",
    "cf:build": "pnpm run cf:env:check && dotenv -e .env.web.cloudflare -- node scripts/build-cloudflare.mjs",
    "cf:build:prod": "dotenv -e .env.web.cloudflare.production -- node scripts/check-cloudflare-env.mjs && dotenv -e .env.web.cloudflare.production -- node scripts/build-cloudflare.mjs",
    "cf:preview": "pnpm --filter @markless/web run start:vinext",
    "cf:smoke": "node scripts/smoke-workers.mjs",
    "cf:test:routing": "node scripts/test-client-routing.mjs",
    "cf:dry-run": "pnpm --filter @markless/web exec wrangler deploy --config dist/server/wrangler.json --dry-run",
    "cf:deploy": "pnpm run cf:build && pnpm --filter @markless/web exec wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:prod": "pnpm run cf:build:prod && pnpm --filter @markless/web exec wrangler deploy --config dist/server/wrangler.json --env production",
    "build:api": "dotenv -e .env.api.local -- next build ./apps/api",
    "start:web": "dotenv -e .env.web.local -- next start ./apps/web --hostname 0.0.0.0 --port 3000",
    "start:api": "dotenv -e .env.api.local -- next start ./apps/api --hostname 0.0.0.0 --port 3001",
    "test:payments": "node --test scripts/payments/payments.test.cjs"
  },
  "dependencies": {
    "@alicloud/alimt20181012": "1.4.2",
    "@alicloud/openapi-client": "0.4.15",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^15.5.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.4",
    "@react-email/render": "^2.0.2",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@trigger.dev/sdk": "4.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@uiw/react-md-editor": "^4.0.8",
    "@upstash/redis": "^1.35.8",
    "better-auth": "^1.4.12",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.44.6",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.8.2",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.3.8",
    "react-email": "^5.2.2",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "smartcrop-sharp": "^2.0.8",
    "sonner": "^2.0.7",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.3.1",
    "youtube-dl-exec": "^3.1.7",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.8",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.19.22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.6",
    "eslint-plugin-i18next": "^6.1.1",
    "playwright": "1.59.1",
    "stylelint": "^16.24.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
