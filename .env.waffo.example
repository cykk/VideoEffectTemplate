# Reference only. Copy values into API and Trigger environment settings.
# Keep Creem credentials and product mappings unchanged.
PAYMENT_PROVIDER=creem
PAYMENT_ONE_TIME_PROVIDER=creem
PAYMENT_SUBSCRIPTION_PROVIDER=creem

# New Waffo checkouts require BOTH flags. Keep operations enabled after rollback.
WAFFO_ENABLED=false
WAFFO_OPERATIONS_ENABLED=false
WAFFO_ENV=test
WAFFO_STORE_ID=
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_TAX_CATEGORY=digital_goods

# Replace all placeholders with actual product IDs from the same store/environment.
# Optional recharge overrides: credit_pack_800:free / :monthly_subscriber / :yearly_subscriber.
WAFFO_PACKS={"credit_pack_800":"PROD_REPLACE800","credit_pack_2000":"PROD_REPLACE2000"}
WAFFO_SUBSCRIPTIONS={"tier1:monthly":"PROD_REPLACET1M","tier1:yearly":"PROD_REPLACET1Y","tier2:monthly":"PROD_REPLACET2M","tier2:yearly":"PROD_REPLACET2Y","tier3:monthly":"PROD_REPLACET3M","tier3:yearly":"PROD_REPLACET3Y"}

# Existing shared settings; use an actual public HTTPS web origin.
PAYMENT_SUCCESS_BASE_URL=https://your-web.example
# Set CRON_SECRET in your secret manager for the optional manual cron endpoint.
