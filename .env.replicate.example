# Add these to the API and Trigger.dev runtime. Leave disabled for a billing-only starter.
REPLICATE_ENABLED=false
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
# JSON object: feature key -> pinned Replicate model version and credit cost.
# Use a real 64-character model version from the chosen Replicate model.
AI_FEATURES={}
# RainDance (two photos, fixed prompt) example:
# AI_FEATURES={"raindance":{"version":"<64-char-version>","credits":20,"kind":"image_pair","imageFields":["image","image_2"],"promptField":"prompt","params":{}}}

# Public HTTPS API origin used for Replicate callbacks when enabled.
NEXT_PUBLIC_APP_URL=https://api.example.com
# Public web origin used for checkout returns and metadata.
NEXT_PUBLIC_WEB_URL=https://app.example.com

# AI image results are stored privately in R2.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
