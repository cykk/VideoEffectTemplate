# Public build-time values only. Never put database/auth/R2 secrets here.
# Copy to .env.web.cloudflare; set WEB_URL to this Worker’s workers.dev preview hostname.
NEXT_PUBLIC_WEB_URL=https://mp3totext-web-preview.<account>.workers.dev
NEXT_PUBLIC_APP_URL=https://api.mp3totext.io
NEXT_PUBLIC_AUTH_BASE_URL=https://api.mp3totext.io
NEXT_PUBLIC_BROWSER_API_BASE_URL=https://api.mp3totext.io
NEXT_PUBLIC_BROWSER_AUTH_BASE_URL=https://api.mp3totext.io
NEXT_PUBLIC_BROWSER_SSE_BASE_URL=https://api.mp3totext.io
NEXT_PUBLIC_APP_ENV=production
# Optional public Google Analytics measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
